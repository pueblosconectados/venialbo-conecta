        "hasMaxFileSize": true,
        "maxFileSize": 8,
        "maxFileSizeUnit": "MB",
        "hasMultipleFiles": true,
        "hasMinFiles": false,
        "hasMaxFiles": true,
        "maxFiles": 4
      }
    },
    {
      "clave": "quien_lo_manda",
      "tipo": "texto",
      "etiqueta": "Tu nombre",
      "requerido": true,
      "ayuda": "Para saber quién nos lo manda. Esto no se publica"
    }
  ]
